# ===========================================================================
# 多智能体 Python 代码生成与辅助审查系统 · Git 忽略规则
# ===========================================================================

# ---- 敏感信息：环境变量（含 API Key、数据库口令），保留 .env.example 模板 ----
.env
.env.*
!.env.example

# ---- Python 字节码与缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试 / 类型检查 / 代码检查缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 运行期产物（程序启动时会自动重建这些目录）----
storage/generated/
storage/logs/
storage/results/
storage/downloads/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统杂项 ----
.DS_Store
Thumbs.db
