# 大模型与数据库配置示例：复制为 .env 并填入真实值（.env 不会提交）

# ===== 大模型（DeepSeek/火山方舟走 OpenAI 兼容接口；Ollama 走本地原生接口）=====
# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 火山方舟（豆包）
DOUBAO_API_KEY=xxxxxxxxxxxxxxxx
DOUBAO_ENDPOINT_ID=ep-xxxxxxxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 本地 Ollama：先启动 Ollama 并确认 `ollama list` 中有对应模型，
# 然后把 LLM_PROVIDER 改为 ollama（不需要 API Key）。
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_TIMEOUT=600
# OLLAMA_MAX_TOKENS=8192
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=0
# OLLAMA_KEEP_ALIVE=30m
# 本地单卡建议关闭并行审查，避免多个请求排队超时
# REVIEW_PARALLEL=0

# ===== 强制离线（调试用）：置 1 时使用内置 Mock，不调用真实 API =====
# FORCE_MOCK=1

# ===== 数据库（默认在 config/settings.py 中配置，一般无需在此重复）=====
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=graduation project

# ===== 测试模式：置 1 时会话编号带 test_ 前缀，测试结束自动清理 =====
# TEST_MODE=1
