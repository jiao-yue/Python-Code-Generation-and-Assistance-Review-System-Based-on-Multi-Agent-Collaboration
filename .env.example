# 大模型与数据库配置示例：复制为 .env 并填入真实值（.env 不会提交）

# ===== 大模型（OpenAI 兼容接口，任选其一）=====
# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 火山方舟（豆包）
DOUBAO_API_KEY=xxxxxxxxxxxxxxxx
DOUBAO_ENDPOINT_ID=ep-xxxxxxxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 强制离线（调试用）：置 1 时使用内置 Mock，不调用真实 API =====
# FORCE_MOCK=1

# ===== 数据库（默认在 config/settings.py 中配置，一般无需在此重复）=====
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=graduation project
